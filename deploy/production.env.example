# Modèle du fichier .env de PRODUCTION (à copier en .env sur le serveur, à côté de docker-compose.yml).
# Ne jamais mettre de vraies valeurs dans ce modèle : il est versionné dans git.

APP_NAME="Eloge"
APP_ENV=production
APP_KEY=                       # générer : echo "APP_KEY=base64:$(openssl rand -base64 32)"
APP_DEBUG=false                # JAMAIS true en production (afficherait les erreurs et secrets)
APP_URL=https://VOTRE-SOUS-DOMAINE.africodehub.net
APP_PORT=8082                  # port local (127.0.0.1) relié au Nginx du serveur

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

# Adresse de l'admin (ex. une adresse moins évidente que « admin »)
ADMIN_PATH=admin

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Base MySQL du conteneur « db » (créée automatiquement au premier démarrage)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=portfolio
DB_USERNAME=portfolio
DB_PASSWORD=                   # générer : openssl rand -hex 24
DB_ROOT_PASSWORD=              # générer : openssl rand -hex 24

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true     # cookies envoyés uniquement en HTTPS
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local

# E-mails via Gmail (mot de passe d'application Google, sans espaces)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Adresse qui reçoit les messages du formulaire de contact
CONTACT_NOTIFICATION_EMAIL=

# Assistant IA (vide = assistant masqué)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
